# Copy this file to ".env" in this same folder and fill in ONE key. Never share the .env file.
# TradingAgents reads .env from the folder you run the commands in.
# Only the key for the provider you pass with --provider is used.

# Economic numbers (interest rates, inflation): a free key from the FRED website (fred.stlouisfed.org).
FRED_API_KEY=
# The online Qwen account (any OpenAI-compatible provider, here IteraCompute).
OPENAI_COMPATIBLE_API_KEY=

GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=

# Optional extra price feed for the live paper accounts (forex and gold). TradingView is the main source and needs no key.
# Open a free fxTrade Practice account at oanda.com, then create a token under "Manage API Access".
OANDA_API_TOKEN=
OANDA_ENV=practice
